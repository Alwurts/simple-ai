{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "simple-ai",
  "homepage": "https://simple-ai.dev",
  "items": [
    {
      "name": "app-shell",
      "type": "registry:block",
      "title": "App shell",
      "description": "Sample layout using the shell.",
      "registryDependencies": [
        "button",
        "empty",
        "sidebar",
        "@simple-ai/shell"
      ],
      "meta": {
        "iframeHeight": 720
      },
      "files": [
        {
          "path": "packages/registry/registry/blocks/app-shell/page.tsx",
          "type": "registry:component",
          "target": "src/features/app-shell/page.tsx"
        },
        {
          "path": "packages/registry/registry/blocks/app-shell/components/app-sidebar.tsx",
          "type": "registry:component",
          "target": "src/features/app-shell/components/app-sidebar.tsx"
        }
      ]
    },
    {
      "name": "chat-api-hono",
      "type": "registry:block",
      "title": "Chat API (Hono)",
      "description": "Hono POST /api/chat. Add with @simple-ai/chat-page, then switch the chat transport.",
      "dependencies": ["hono"],
      "registryDependencies": ["@simple-ai/chat-handler"],
      "files": [
        {
          "path": "packages/registry/registry/blocks/chat-api-hono/chat-hono.ts",
          "type": "registry:lib",
          "target": "src/features/assistant/lib/chat-hono.ts"
        }
      ]
    },
    {
      "name": "chat-api-next",
      "type": "registry:block",
      "title": "Chat API (Next.js)",
      "description": "App Router POST /api/chat. Add with @simple-ai/chat-page, then switch the chat transport.",
      "registryDependencies": ["@simple-ai/chat-handler"],
      "files": [
        {
          "path": "packages/registry/registry/blocks/chat-api-next/route.ts",
          "type": "registry:file",
          "target": "src/app/api/chat/route.ts"
        }
      ]
    },
    {
      "name": "chat-handler",
      "type": "registry:block",
      "title": "Chat handler",
      "description": "Shared Request/Response chat handler. Use with chat-api-next or chat-api-hono.",
      "dependencies": ["ai"],
      "files": [
        {
          "path": "packages/registry/registry/blocks/chat-handler/chat-handler.ts",
          "type": "registry:lib",
          "target": "src/features/assistant/lib/chat-handler.ts"
        }
      ]
    },
    {
      "name": "chat-input",
      "type": "registry:ui",
      "title": "Chat Input",
      "description": "Chat composer with mentions and streaming status.",
      "dependencies": [
        "@tiptap/core",
        "@tiptap/react",
        "@tiptap/starter-kit",
        "@tiptap/extension-mention",
        "@tiptap/extension-placeholder",
        "@tiptap/suggestion",
        "ai"
      ],
      "registryDependencies": ["input-group"],
      "files": [
        {
          "path": "packages/registry/registry/components/chat-input/chat-input.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "chat-page",
      "type": "registry:block",
      "title": "Chat page",
      "description": "Full screen chat with tools, files, and mentions.",
      "registryDependencies": [
        "attachment",
        "bubble",
        "button",
        "collapsible",
        "dropdown-menu",
        "empty",
        "input-group",
        "marker",
        "message",
        "message-scroller",
        "resizable",
        "sidebar",
        "@simple-ai/chat-input",
        "@simple-ai/chat-voice-button",
        "@simple-ai/reasoning",
        "@simple-ai/shell",
        "@simple-ai/tool"
      ],
      "dependencies": ["@ai-sdk/react", "@shadcn/helpers", "ai", "streamdown"],
      "meta": {
        "iframeHeight": 900
      },
      "files": [
        {
          "path": "packages/registry/registry/blocks/chat-page/page.tsx",
          "type": "registry:component",
          "target": "src/features/assistant/page.tsx"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/lib/mock-chat-messages.ts",
          "type": "registry:lib",
          "target": "src/features/assistant/lib/mock-chat-messages.ts"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/lib/chat-transport.ts",
          "type": "registry:lib",
          "target": "src/features/assistant/lib/chat-transport.ts"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/components/app-sidebar.tsx",
          "type": "registry:component",
          "target": "src/features/assistant/components/app-sidebar.tsx"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/components/full-screen-chat.tsx",
          "type": "registry:component",
          "target": "src/features/assistant/components/full-screen-chat.tsx"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/components/chat-input.tsx",
          "type": "registry:component",
          "target": "src/features/assistant/components/chat-input.tsx"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/components/chat-message-parts.tsx",
          "type": "registry:component",
          "target": "src/features/assistant/components/chat-message-parts.tsx"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/components/chat-side-panel.tsx",
          "type": "registry:component",
          "target": "src/features/assistant/components/chat-side-panel.tsx"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/components/file-explorer-tree.tsx",
          "type": "registry:component",
          "target": "src/features/assistant/components/file-explorer-tree.tsx"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/hooks/use-chat-side-panel.ts",
          "type": "registry:hook",
          "target": "src/features/assistant/hooks/use-chat-side-panel.ts"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/lib/mock-workspace-tree.ts",
          "type": "registry:lib",
          "target": "src/features/assistant/lib/mock-workspace-tree.ts"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/lib/mock-members.ts",
          "type": "registry:lib",
          "target": "src/features/assistant/lib/mock-members.ts"
        },
        {
          "path": "packages/registry/registry/blocks/chat-page/lib/ai-types.ts",
          "type": "registry:lib",
          "target": "src/features/assistant/lib/ai-types.ts"
        }
      ]
    },
    {
      "name": "chat-voice-button",
      "type": "registry:ui",
      "title": "Chat Voice Button",
      "description": "Record and transcribe into the chat input.",
      "dependencies": ["sonner"],
      "registryDependencies": ["input-group", "sonner"],
      "files": [
        {
          "path": "packages/registry/registry/components/chat-voice-button/chat-voice-button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "reasoning",
      "type": "registry:ui",
      "title": "Reasoning",
      "description": "Collapsible thinking with duration and markdown.",
      "dependencies": ["motion", "streamdown"],
      "registryDependencies": ["collapsible"],
      "files": [
        {
          "path": "packages/registry/registry/components/reasoning/reasoning.tsx",
          "type": "registry:ui"
        },
        {
          "path": "packages/registry/registry/components/reasoning/shimmer.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "shell",
      "type": "registry:ui",
      "title": "Shell",
      "description": "Sidebar, header, and main content.",
      "registryDependencies": ["button", "sidebar"],
      "meta": {
        "fullBleed": true,
        "iframeHeight": 720
      },
      "files": [
        {
          "path": "packages/registry/registry/components/shell/shell.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "tool",
      "type": "registry:ui",
      "title": "Tool",
      "description": "Tool call with status, params, and output.",
      "dependencies": ["ai", "shiki"],
      "registryDependencies": ["badge", "button", "collapsible"],
      "files": [
        {
          "path": "packages/registry/registry/components/tool/tool.tsx",
          "type": "registry:ui"
        },
        {
          "path": "packages/registry/registry/components/tool/code-block.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
