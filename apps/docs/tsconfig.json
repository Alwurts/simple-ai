{
  "extends": "@workspace/tsconfig/tanstack-start.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["vite.config.ts"],
  "compilerOptions": {
    "paths": {
      "@/components/ui/composer": [
        "../../packages/registry/registry/components/composer/composer.tsx"
      ],
      "@/components/ui/shell": [
        "../../packages/registry/registry/components/shell/shell.tsx"
      ],
      "@/components/ui/reasoning": [
        "../../packages/registry/registry/components/reasoning/reasoning.tsx"
      ],
      "@/components/ui/tool": [
        "../../packages/registry/registry/components/tool/tool.tsx"
      ],
      "@/components/ui/*": ["../../packages/ui/src/components/shadcn/*"],
      "@/lib/utils": ["../../packages/ui/src/lib/utils.ts"],
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    },
    "types": ["./worker-configuration.d.ts", "node", "vite/client"]
  }
}
