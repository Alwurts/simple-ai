    {
      "name": "chat-api-hono",
      "type": "registry:block",
      "title": "Chat API (Hono)",
      "description": "Hono POST /api/chat. Add with @simple-ai/chat-page and an agent, then switch the chat transport.",
      "dependencies": ["hono"],
      "registryDependencies": ["@simple-ai/agent-handle"],
      "envVars": {
        "AI_GATEWAY_API_KEY": "",
        "AI_MODEL": "openai/gpt-4.1-mini"
      },
      "docs": "Writes a Hono app at src/features/assistant/lib/chat-hono.ts. Also pulls the weather agent and handleAgent.\n\nMount with app.route(\"/\", chatApp) or chatApp.fetch(request).\n\nThen in src/features/assistant/lib/chat-transport.ts:\n\n  import { DefaultChatTransport } from \"ai\";\n  export const chatTransport = new DefaultChatTransport({ api: \"/api/chat\" });\n  export const initialChatMessages = undefined;\n\nSet AI_GATEWAY_API_KEY and optionally AI_MODEL.",
      "files": [
        {
          "path": "packages/registry/registry/blocks/chat-api-hono/chat-hono.ts",
          "type": "registry:lib",
          "target": "src/features/assistant/lib/chat-hono.ts"
        }
      ]
    },
