{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "@workspace/biome-config/core",
    "@workspace/biome-config/react",
    "@workspace/biome-config/tanstack"
  ],
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedAttributes": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedProperties": "off",
        "useSortedTypeFields": "off"
      }
    }
  },
  "files": {
    "includes": ["!**/.source", "!**/apps/docs/public/r"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        "noImgElement": "off",
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "noLeakedRender": "off",
        "noEqualsToNull": "off",
        "noShadow": "off",
        "noUnusedExpressions": "off",
        "noUnnecessaryConditions": "off",
        "noConsole": "off"
      },
      "style": {
        "useDestructuring": "off",
        "noIncrementDecrement": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/*/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/registry/registry/ui/world-card.tsx",
        "packages/registry/registry/blocks/chat-card/**",
        "packages/registry/registry/examples/world-card-demo*.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          },
          "complexity": {
            "noVoid": "off",
            "useSimplifiedLogicExpression": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "useNumericSeparators": "off",
            "useConsistentTypeDefinitions": "off"
          },
          "suspicious": {
            "noUnknownAttribute": "off",
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ]
}
