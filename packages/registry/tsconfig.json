{
  "extends": "@workspace/tsconfig/react-library-bundler.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@workspace/registry/*": ["./src/*"],
      "@/components/ui/chat-input": [
        "./registry/components/chat-input/chat-input.tsx"
      ],
      "@/components/ui/shell": ["./registry/components/shell/shell.tsx"],
      "@/components/ui/reasoning": [
        "./registry/components/reasoning/reasoning.tsx"
      ],
      "@/components/ui/tool": ["./registry/components/tool/tool.tsx"],
      "@/components/ui/chat-voice-button": [
        "./registry/components/chat-voice-button/chat-voice-button.tsx"
      ],
      "@/components/ui/*": ["../ui/src/components/shadcn/*"],
      "@/lib/utils": ["../ui/src/lib/utils.ts"],
      "@/features/assistant/lib/agent": [
        "./registry/agents/weather-agent/agent.ts"
      ],
      "@/features/assistant/lib/handle-agent": [
        "./registry/blocks/agent-handle/handle-agent.ts"
      ]
    }
  },
  "include": ["src", "registry", "scripts", "../tsconfig/css-modules.d.ts"],
  "exclude": ["node_modules", "dist"]
}
